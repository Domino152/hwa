# ===========================================
# College WhatsApp Assistant — Environment
# ===========================================
# Copy this file to .env and fill in values
#
# SECURITY: Never commit .env to version control.
# SECURITY: In production, ALL variables must be set — no defaults are used.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- MongoDB ---
# Required. Use a production-grade connection string with auth in production.
MONGO_URI=mongodb://localhost:27017/college_whatsapp

# --- CORS ---
# Comma-separated list of allowed origins.
# Required in production (app will fail to start without it).
# Add the GitHub Pages origin when the frontend is hosted there.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://domino152.github.io

# --- Logging ---
LOG_LEVEL=info

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- WhatsApp Session ---
WA_SESSION_DIR=./auth_info
# Checks the Baileys connection while this process is running. This does not
# prevent a hosting provider from suspending the service.
WA_WATCHDOG_INTERVAL_MS=30000

# --- Authentication ---
# Required. Must be >= 32 characters.
# Generate a strong secret: openssl rand -base64 48
# NEVER use weak/default values in production — the app will reject them.
JWT_SECRET=your-64-character-random-string-here-generate-with-openssl
JWT_EXPIRES_IN=7d

# Public application URL used for login links sent via WhatsApp.
# Set it to the app ROOT (no path, no "/#/login" — the code appends the hash route):
#   login URL = PUBLIC_APP_URL + "/#/login?token=<token>"
# In development: http://localhost:5173
# In production: https://domino152.github.io/hwa (must be a public HTTPS URL,
#   no localhost, no private IPs).
# Login tokens are appended as ?token=<token> — never uses phone numbers.
PUBLIC_APP_URL=http://localhost:5173

# Cost factor for bcrypt password hashing (4–20). Default: 10.
BCRYPT_ROUNDS=10

# --- Gemini AI (Natural Language Understanding) ---
# Google Gemini API key. Required in production for AI classification.
# Get one at: https://aistudio.google.com/apikey
# SECURITY: Never commit a real key to version control.
GEMINI_API_KEY=

# Gemini model used for intent classification. Default: gemini-2.5-flash.
# The model is used only for structured-intent classification — it has NO
# access to MongoDB or any backend data. All data retrieval and response
# formatting is performed by the backend after the model classifies intent.
GEMINI_MODEL=gemini-2.5-flash
